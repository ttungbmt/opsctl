{
  "name": "@ops/cli",
  "version": "0.1.0",
  "repository": "github:ttungbmt/opsctl",
  "private": true,
  "type": "module",
  "bin": {
    "ops": "./bin/run.js"
  },
  "files": [
    "bin",
    "config",
    "dist"
  ],
  "oclif": {
    "bin": "ops",
    "topics": {
      "profile": {
        "description": "Inspect machine profiles"
      },
      "tool": {
        "description": "Install, configure and remove tools"
      }
    },
    "dirname": "ops",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc -p test"
  },
  "dependencies": {
    "@oclif/core": "^5.0.0",
    "ansis": "^3.17.0",
    "execa": "^10.0.1",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "oclif": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
